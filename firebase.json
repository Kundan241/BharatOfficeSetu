{
  "hosting": {
    "public": "dist",
    "cleanUrls": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/dashboard/**",
        "destination": "/index.html"
      },
      {
        "source": "/partner-dashboard/**",
        "destination": "/index.html"
      },
      {
        "source": "/admin/**",
        "destination": "/index.html"
      },
      {
        "source": "/login",
        "destination": "/index.html"
      },
      {
        "source": "/set-password",
        "destination": "/index.html"
      },
      {
        "source": "/change-password",
        "destination": "/index.html"
      },
      {
        "source": "/drafts",
        "destination": "/index.html"
      }
    ]
  }
}
